[Unit]
Description=AtriMeow SkyBlock price service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=skyblock-price
Group=skyblock-price
WorkingDirectory=/opt/skyblock-price-service
EnvironmentFile=/etc/skyblock-price-service.env
Environment=PRICE_CONFIG=/etc/skyblock-price-service.toml
Environment=RUST_LOG=skyblock_price_service=info
ExecStart=/opt/skyblock-price-service/skyblock-price-service
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
StateDirectory=skyblock-price-service
MemoryHigh=256M
MemoryMax=512M
TasksMax=32
LimitNOFILE=1024
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/skyblock-price-service
UMask=0077

[Install]
WantedBy=multi-user.target
